{
  "displayName": "NeMo-RL Training Dashboard",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Train Loss",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rl.train.loss"
                },
                "plotType": "LINE",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "Values"
              }
            ],
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Reward Mean",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rl.environment.reward.mean"
                },
                "plotType": "LINE",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "Values"
              }
            ],
            "yAxis": {
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Step Time (ms)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.5, sum(rate(rl.step.duration_bucket[1m])) by (le))",
                  "unitOverride": "ms"
                },
                "plotType": "LINE",
                "legendTemplate": "p50",
                "minAlignmentPeriod": "60s"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.9, sum(rate(rl.step.duration_bucket[1m])) by (le))",
                  "unitOverride": "ms"
                },
                "plotType": "LINE",
                "legendTemplate": "p90",
                "minAlignmentPeriod": "60s"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum(rate(rl.step.duration_bucket[1m])) by (le))",
                  "unitOverride": "ms"
                },
                "plotType": "LINE",
                "legendTemplate": "p99",
                "minAlignmentPeriod": "60s"
              }
            ],
            "yAxis": {
              "label": "Duration (ms)",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
